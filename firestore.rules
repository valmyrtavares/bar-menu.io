rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES DE SEGURANÇA
    // ==========================================
    
    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário logado é o proprietário do ID do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário é Administrador
    // (Através do login por E-mail/Senha normal do Firebase Auth ou se cadastrado na coleção 'admins')
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.firebase.sign_in_provider == 'password' || 
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Verifica se a requisição passou pelo Firebase App Check (reCAPTCHA)
    // (Para ativar em produção, basta descomentar a linha abaixo)
    function isAppCheckVerified() {
      // return request.appCheck != null;
      return true;
    }



    // ==========================================
    // REGRAS POR COLEÇÃO
    // ==========================================

    // 1. Coleção de Usuários (/user)
    match /user/{userId} {
      // Permitimos ler, criar e atualizar para dar suporte à busca por CPF de novos visitantes e cadastro de UIDs legados
      allow read, create, update: if true;
      allow delete: if isAuthenticated() || isAdmin();
    }

    // 2. Coleção de Pedidos (/requests)
    match /requests/{requestId} {
      // Permitimos ler, criar e atualizar para dar suporte à emissão de pedidos por clientes anônimos, totens e UIDs legados
      allow read, create, update: if true;
      
      // Apenas administradores podem deletar pedidos
      allow delete: if isAdmin();
    }

    // 3. Coleções do Cardápio (item, button, sideDishes, welcomeCustomer, category, dishes)
    // Qualquer visitante do site (mesmo sem login) pode ler o cardápio, mas apenas o Admin pode editar
    match /category/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dishes/{dishId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /item/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /button/{buttonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sideDishes/{sideDishId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /welcomeCustomer/{welcomeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /styles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /GlobalConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /frontImage/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Coleção de Controle de Estoque (stock)
    match /stock/{stockId} {
      allow read, write: if true;
    }

    // 5. Coleção de Documentos Fiscais (taxDocuments) e BenefitedCustomer
    match /taxDocuments/{docId} {
      allow read, write: if true;
    }

    match /BenefitedCustomer/{docId} {
      allow read, write: if true;
    }

    // Coleção de Histórico de Auditoria do Estoque
    match /stockUsageLogs/{docId} {
      allow read, write: if true;
    }

    match /dailyStockSnapshot/{docId} {
      allow read, write: if true;
    }

    match /inventoryHistory/{docId} {
      allow read, write: if true;
    }

    match /recipeAdjustmentsLogs/{docId} {
      allow read, write: if true;
    }

    match /outgoing/{docId} {
      allow read, write: if true;
    }

    // Coleção de Promoções
    match /Promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Coleção de Administradores (/admins)
    // Apenas outros administradores podem gerenciar a lista de administradores
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Regra de Fallback / Catch-All
    // Protege qualquer outra coleção não especificada acima, liberando acesso apenas para admins
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
